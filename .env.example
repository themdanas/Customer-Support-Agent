# Database Connection (Docker PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_agent

# Groq LLM & Multimodal Vision API Key
GROQ_API_KEY=your_groq_api_key_here

# Default Model (supports structured reasoning and multimodal vision)
GROQ_MODEL=qwen/qwen3.8-27b

# Python Module Search Path
PYTHONPATH=.

